PORT=6000
DB_HOST=
DB_USER=
DB_PASSWORD=
DB_DATABASE=ambient

# Which location's forecast this station shows.
#
# The forecast table is keyed on (location_id, datetime) and holds a row per
# location per day, so a query without this returns several locations
# interleaved by date. Required, because there is no safe default — the
# forecaster does not know where this station stands.
#
# Find the id on the forecaster's /locations page.
FORECAST_LOCATION_ID=1
ALERT_CRON="*/15 * * * *"
LAT=
LON=
LOGLEVEL=Info
WEATHER_API=
