# Compose configuration for the weather stack.
#
#   cp .env.example .env
#
# Compose reads .env from beside docker-compose.yml and substitutes ${VAR}
# before starting anything. Values marked REQUIRED use ${VAR:?...}, so Compose
# refuses to start and says which one is missing rather than substituting an
# empty string and failing later as an authentication error.
#
# .env is gitignored (`*.env`). This file is not — keep secrets out of it.

# --- image registry and versions -------------------------------------------
REGISTRY=docker.zoms.net
SERVER_TAG=v5.1.2
PROCESSOR_TAG=v3.0.2
STATS_TAG=v1.1.2
UI_TAG=v3.3.2

# --- host ports -------------------------------------------------------------
SERVER_PORT=6001
PROCESSOR_PORT=7501
STATS_PORT=7500
UI_PORT=6000

# --- database ---------------------------------------------------------------
# The server takes these as separate variables; the processor and stats take a
# DATABASE_URL, which Compose assembles from exactly these.
DB_HOST=10.10.1.120
DB_PORT=5432
DB_USER=ambient
DB_NAME=ambient
DB_SSLMODE=disable
# REQUIRED.
DB_PASSWORD=

# Which location's forecast the UI shows. REQUIRED.
#
# The forecast table is keyed on (location_id, datetime), so a query without
# this returns every location interleaved by date — five days of two places
# looking exactly like ten days of one. Find the id on the forecaster's
# /locations page; confirm it after running the forecaster's migrations, since
# the pins are created by migration 006 from whatever rows already existed.
FORECAST_LOCATION_ID=

# --- station ----------------------------------------------------------------
# REQUIRED: no sensible default for where a weather station is.
LAT=38.725798
LON=-104.66783
STATION_ID=KCOS
STATION_MAC=WS-5000
# Metres. REQUIRED — used to reduce station pressure to sea level, and a wrong
# value biases every barometric reading rather than failing.
ELEVATION=1746.5
TZ=America/Denver
LOGLEVEL=Info

# --- MQTT -------------------------------------------------------------------
MQTT_BROKER=tcp://10.10.1.124:1883
MQTT_USER=brian
MQTT_TOPIC=ambient/#
MQTT_STATS_TOPIC=weather/stats
# REQUIRED.
#
# Its own variable, not a reuse of DB_PASSWORD. The compose file previously set
# MQTT_PASS=${DB_PASSWORD}, so the broker and the database shared one secret and
# neither could be rotated without the other. They can hold the same value if
# that is what the broker is configured with — but they are now two decisions.
MQTT_PASSWORD=

# --- schedules --------------------------------------------------------------
ALERT_CRON=*/15 * * * *
FORECAST_CRON=0 */4 * * *
CONDITIONS_CRON=*/15 * * * *
SNAPSHOT_INTERVAL=1m
RAIN_EVENT_GAP=1h

# --- external services ------------------------------------------------------
# REQUIRED: the NWS/weather API key the stats service uses.
WEATHER_API=vc_api_key

# --- infrastructure ---------------------------------------------------------
GITLAB_HOST_IP=10.10.1.124
